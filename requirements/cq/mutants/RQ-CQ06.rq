PREFIX risk: <https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#>
PREFIX ex: <urn:riskium:cq-fixture:>
PREFIX app: <urn:riskium:cq-profile:0.1.0#>
PREFIX ap: <https://github.com/ArazSaieArasi3/riskium/profiles/catalog/0.3.0#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT DISTINCT ?statement ?source ?locator ?origin WHERE {
 ?reference risk:R-68 ?statement; risk:RX-021 ?item .
 ?record ap:candidate ?reference .
 ?otherRecord dct:source ?source .
 ?record app:sourceLocator ?locator; app:interpretationOrigin ?origin .
}
