PREFIX risk: <https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#>
PREFIX ex: <urn:riskium:cq-fixture:>
PREFIX app: <urn:riskium:cq-profile:0.1.0#>
PREFIX ap: <https://github.com/ArazSaieArasi3/riskium/profiles/catalog/0.3.0#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT DISTINCT ?score ?value ?scaleVersion ?scale WHERE {
 ?score risk:R-18 ?result .
 ?otherResult risk:RX-016 ?scaleVersion .
 ?scaleVersion risk:RX-006 ?scale . ?scale a risk:RKM-C036 .
 ?record ap:candidate ?score; app:numericValue ?value .
}
