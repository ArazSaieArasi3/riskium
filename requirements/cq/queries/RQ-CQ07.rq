PREFIX risk: <https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#>
PREFIX ex: <urn:riskium:cq-fixture:>
PREFIX app: <urn:riskium:cq-profile:0.1.0#>
PREFIX ap: <https://github.com/ArazSaieArasi3/riskium/profiles/catalog/0.3.0#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT DISTINCT ?correctionRecord ?previousRecord ?source WHERE {
 ?correctionRecord prov:wasRevisionOf ?previousRecord; ap:candidate ?currentVersion; dct:source ?source .
 ?previousRecord ap:candidate ?previousVersion .
 ?currentVersion risk:RX-006 ?artifact . ?previousVersion risk:RX-006 ?artifact .
}
