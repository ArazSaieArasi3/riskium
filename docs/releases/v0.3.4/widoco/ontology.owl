.1#" n0:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</n2:isAbstractInSource><n2:ontoumlStereotype xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#">subkind</n2:ontoumlStereotype><n2:sourceId xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#">RKM-C060</n2:sourceId></n0:Description><n0:Description n0:about="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#RKM-C061"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A controlled value describing handling or processing status under a specified workflow scheme. This is a managed vocabulary resource with scheme-qualified identity, not a bare string.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">WorkflowStateTerm</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#RKM-C019"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb30b4a7ce0044f88bd0010a3ffe4d6cd5d75dc42844d57cf1a765081de1af3f9c0"></n1:subClassOf><n2:isAbstractInSource xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#" n0:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</n2:isAbstractInSource><n2:ontoumlStereotype xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#">subkind</n2:ontoumlStereotype><n2:sourceId xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#">RKM-C061</n2:sourceId></n0:Description><n0:Description n0:about="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#RKM-C062"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A qualified statement about a record's state, preserving the source and available temporal precision.</n1:comment><n1:labe