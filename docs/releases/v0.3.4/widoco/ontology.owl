um/ontologies/riskium/0.3.1#" n0:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</n2:isAbstractInSource><n2:ontoumlStereotype xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#">subkind</n2:ontoumlStereotype><n2:sourceId xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#">RKM-C063</n2:sourceId></n0:Description><n0:Description n0:about="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#RKM-C064"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A temporally bounded situation in which a managed record revision has an assigned workflow state under an identified scheme version; the statement documenting this situation is separate.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">WorkflowAssignment</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb244225760b7cf9dc7efe399facb3e630bb55efcee70001b3ae04616a42dbc110f"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb269010a1a71ed6ccfda066acd0a6303b083aee319797572144bfc4dc627fecf12"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb2bec34d6619f2166eccda22a9f6e31f670bd858e98a589745f84b6d76c749efcd"></n1:subClassOf><n2:isAbstractInSource xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#" n0:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</n2:isAbstractInSource><n2:ontoumlStereotype xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#">situation</n2:ontoumlStereotype><n2:sourceId xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#">RKM-C064</n2:sourceId></n0:Description><n0:Description n0:about="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#RKM-C065"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A qualified reference linking a claim or activity to an evidence item, with its intended evidential role and provenance.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">EvidenceReference</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#RKM-C014"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb21e9034a927d67547cf2de8293aac9675ae03592c23a8ee3106f8fb0666d58b71"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb34410c489775288ed27e1fc44d1f63164d1bd4ec9ba3f4740360b7b783af6e211"></n1:subClassOf><n2:isAbstractInSource xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#" n0:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</n2:isAbstractInSource><n2:ontoumlStereotype xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#">subkind</n2:ontoumlStereotype><n2:sourceId xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#">RKM-C065</n2:sourceId></n0:Description><n0:Description n0:about="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#RKM-C066"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An information artifact playing an evidential role for a specified claim or analytical activity. The same artifact may be used as evidence in one context and not another.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">EvidenceItem</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#RKM-C014"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb2c4c312b2b8eea312d3d9610bf2c8dd16b675e47f7893f72c23754ff07742fa4d"></n1:subClassOf><n2:isAbstractInSource xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#" n0:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</n2:isAbstractInSource><n2:ontoumlStereotype xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#">role</n2:ontoumlStereotype><n2:sourceId xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#">RKM-C066</n2:sourceId></n0:Description><n0:Description n0:about="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#RKM-C067"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An activity that observes a stated feature of a subject using a declared procedure and temporal context.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">ObservationActivity</n1:label><n2:isAbstractInSource xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#" n0:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</n2:isAbstractInSource><n2:ontoumlStereotype xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#">event</n2:ontoumlStereotype><n2:sourceId xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#">RKM-C067</n2:sourceId></n0:Description><n0:Description n0:about="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#RKM-C068"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An information result produced by an observation activity, qualified by subject, time, method and available units.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">ObservationResult</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#RKM-C014"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb26546c0cd15da2876325c6dcb78af83bad9a11d5d7629022758725669bae0c2e6"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb2fc5c08e7ffe88870d067ab16863faf0b21c1b8c44c6c26c7e684dc8d5fa206cf"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb31ad5ec7200981cdcad6749adf95cfe4a69eea0f968b2609c69e0fdecc7d8d365"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb4002c9b3010ba4e0cf4f68f43cdebe608fb1df3d7c6f2f8acb692f2c8f5a5dd8c"></n1:subClassOf><n2:isAbstractInSource xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#" n0:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</n2:isAbstractInSource><n2:ontoumlStereotype xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#">subkind</n2:ontoumlStereotype><n2:sourceId xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#">RKM-C068</n2:sourceId></n0:Description><n0:Description n0:about="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#RKM-C069"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A versioned information specification of an observable or computed indicator, including its intended interpretation. A reported indicator value is an ObservationResult, not the specification.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Indicator</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#RKM-C014"></n1:subClassOf><n2:isAbstractInSource xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#" n0:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</n2:isAbstractInSource><n2:ontoumlStereotype xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#">subkind</n2:ontoumlStereotype><n2:sourceId xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#">RKM-C069</n2:sourceId></n0:Description><n0:Description n0:about="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#RKM-C070"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A versioned information specification of a context-qualified decision boundary for an indicator or assessment scale, with a comparator, permissible value interpretation and applicability context.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Threshold</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#RKM-C014"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb247867cb4f159eac9eb3f07c76ed12d05a7d7e7b6436896bd308cf45ca7160f64"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb26a1c30ae3a06c436bbfe32f6af20feae05f509d9bdb9910aa47275a7e46c676a"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cbf13e0141bf64dac5cb479f04e0c2210c91ca9fb19307aea2f468a9ff50f3586b"></n1:subClassOf><n2:isAbstractInSource xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#" n0:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</n2:isAbstractInSource><n2:ontoumlStereotype xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#">subkind</n2:ontoumlStereotype><n2:sourceId xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#">RKM-C070</n2:sourceId></n0:Description><n0:Description n0:about="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#RKM-C071"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An information item indicating a potentially relevant change or condition and potentially prompting review; it does not by itself establish a risk event.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">Signal</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#RKM-C014"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb37c34815fb80c9dcf4f5d7507d35f656e7f50536c29a8426428ca246222a302ea"></n1:subClassOf><n2:isAbstractInSource xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#" n0:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</n2:isAbstractInSource><n2:ontoumlStereotype xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#">subkind</n2:ontoumlStereotype><n2:sourceId xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#">RKM-C071</n2:sourceId></n0:Description><n0:Description n0:about="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#RKM-C072"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A versioned information specification of reference conditions used to judge the significance or acceptability of risk in an identified context.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">RiskCriteria</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#RKM-C014"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb361293a882a6b6edb407983c6c31c2de1bfed27d4c9bfeba6bc441787699b91e0"></n1:subClassOf><n2:isAbstractInSource xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#" n0:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</n2:isAbstractInSource><n2:ontoumlStereotype xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#">subkind</n2:ontoumlStereotype><n2:sourceId xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#">RKM-C072</n2:sourceId></n0:Description><n0:Description n0:about="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#RKM-C073"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A managed, versioned statement recording the kinds and extent of risk an organization is prepared to pursue or retain, qualified by source framework, objectives, authority and context.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">RiskAppetiteStatement</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#RKM-C014"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb29f7d638566a580da8620f98cdb5f742c9f9fd1d4cfa56db984d2cae1d0539e14"></n1:subClassOf><n2:isAbstractInSource xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#" n0:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</n2:isAbstractInSource><n2:ontoumlStereotype xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#">subkind</n2:ontoumlStereotype><n2:sourceId xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#">RKM-C073</n2:sourceId></n0:Description><n0:Description n0:about="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#RKM-C074"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A managed, versioned statement recording an organization's stated risk tolerance under an explicitly identified source vocabulary or framework and context. Permissible deviation and readiness to bear remaining risk are retained as distinct source meanings, not silently merged.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">RiskToleranceStatement</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#RKM-C014"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb383c709281300a8a03f0ef823b96d4bfdf7a44da20dadea3811974ecd9b8fd7a2"></n1:subClassOf><n2:isAbstractInSource xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#" n0:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</n2:isAbstractInSource><n2:ontoumlStereotype xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#">subkind</n2:ontoumlStereotype><n2:sourceId xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#">RKM-C074</n2:sourceId></n0:Description><n0:Description n0:about="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#RKM-X01"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">An instituted, identifiable subject of enterprise-risk analysis and tracking. It persists across its descriptions, reassessments, responsibilities and administrative record states under a governed identity policy. It is neither its register entry nor a scenario specification nor an actual occurrence.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">RiskCase</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb30c45cdbd796cc874a026da3afddc8772fb20a50345f867e498855a9c14c4a684"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb3828a808ce7825bc9115698d34d128b556f8240f93ba940d029d76131624ed6b2"></n1:subClassOf><n2:isAbstractInSource xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#" n0:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</n2:isAbstractInSource><n2:ontoumlStereotype xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#">kind</n2:ontoumlStereotype><n2:sourceId xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#">RKM-X01</n2:sourceId></n0:Description><n0:Description n0:about="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#RKM-X02"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A managed information item identifying an objective in its source context, without asserting that the information item is the objective.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">ObjectiveReference</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#RKM-C014"></n1:subClassOf><n2:isAbstractInSource xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#" n0:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</n2:isAbstractInSource><n2:ontoumlStereotype xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#">subkind</n2:ontoumlStereotype><n2:sourceId xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#">RKM-X02</n2:sourceId></n0:Description><n0:Description n0:about="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#RKM-X03"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A managed statement of what is uncertain about a risk case, including assumptions and evidential limitations; it does not imply a numerical probability.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">UncertaintyStatement</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#RKM-C014"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb2c7d4f4500423eded9fd8ed88453de85e0e5d909dd23a3b0807ef7c9e64f48fba"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb39f2efb2889b8c24411ef422d4cea1957059f138b66e1d0dfa39f7d21bc7362f1"></n1:subClassOf><n2:isAbstractInSource xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#" n0:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</n2:isAbstractInSource><n2:ontoumlStereotype xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#">subkind</n2:ontoumlStereotype><n2:sourceId xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#">RKM-X03</n2:sourceId></n0:Description><n0:Description n0:about="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#RKM-X04"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A recorded judgment of risk significance or acceptability based on identified assessment information and criteria versions. It is distinct from a numeric score and from the evaluation activity.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">RiskEvaluationOutcome</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#RKM-C014"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb26a04fa992c80e0f57cc58c9ed4b88ac1c0f4e634def594b12f532ff1730301be"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb2834a87e3ba09714a6610fec1c3ed8db326ff10fdf6040515f33830066783a480"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb2ee4dbb0fc0d67c929603d2870b42dd0cb8d5318c3bf20f089c1df7f71032451a"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb35678924b6f5b23c3dcf3f776c39296cee546d2c2f2559d4a661341733febe5c5"></n1:subClassOf><n2:isAbstractInSource xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#" n0:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</n2:isAbstractInSource><n2:ontoumlStereotype xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#">subkind</n2:ontoumlStereotype><n2:sourceId xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#">RKM-X04</n2:sourceId></n0:Description><n0:Description n0:about="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#RKM-X05"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A managed identifier or description of a claimed control whose real-world bearer may remain unresolved.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">ControlReference</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#RKM-C014"></n1:subClassOf><n2:isAbstractInSource xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#" n0:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</n2:isAbstractInSource><n2:ontoumlStereotype xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#">subkind</n2:ontoumlStereotype><n2:sourceId xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#">RKM-X05</n2:sourceId></n0:Description><n0:Description n0:about="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#RKM-X06"><n0:type n0:resource="http://www.w3.org/2002/07/owl#Class"></n0:type><n1:comment xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">A managed information artifact identifying or describing a claimed contributor to risk in a declared context. The referenced contributor may be unresolved, hypothetical or heterogeneous. The reference does not establish actual causation or an actual occurrence.</n1:comment><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">RiskSourceReference</n1:label><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#RKM-C014"></n1:subClassOf><n1:subClassOf xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:nodeID="cb319e7f8476689875e9e216044880adde62323087f67f2d2a73bf71c385df4d871"></n1:subClassOf><n2:isAbstractInSource xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#" n0:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</n2:isAbstractInSource><n2:ontoumlStereotype xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#">subkind</n2:ontoumlStereotype><n2:sourceId xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#">RKM-X06</n2:sourceId></n0:Description><n0:Description n0:about="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#RX-001"><n0:type n0:resource="http://www.w3.org/2002/07/owl#ObjectProperty"></n0:type><n1:domain xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#RKM-X01"></n1:domain><n1:label xmlns:n1="http://www.w3.org/2000/01/rdf-schema#">hasContext</n1:label><n1:range xmlns:n1="http://www.w3.org/2000/01/rdf-schema#" n0:resource="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#RKM-C002"></n1:range><n2:relationStereotype xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#">ordinary</n2:relationStereotype><n2:sourceEndCardinality xmlns:n2="https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#">0..*</n2:sourceEndCardinality><n2:sourceId xmlns:n