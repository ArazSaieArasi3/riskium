  {
    "@id": "https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#RKM-C001",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A managed, reusable information specification of risk-relevant conditions and possible effects. Its identity is distinct from a particular risk case, a scenario execution and the uncertain effects themselves."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "RiskPatternSpecification"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#RKM-C014"
