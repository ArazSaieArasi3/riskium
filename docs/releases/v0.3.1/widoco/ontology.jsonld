    ]
  },
  {
    "@id": "https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#RKM-C003",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A managed information specification of a possible development of conditions, events and effects concerning one or more RiskCases. Several scenarios may concern one case; a scenario is not the case or an actual occurrence."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "RiskScenarioSpecification"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "_:cb2baefa84453950b36953da33754c266f0be26382a384f8b00571589f5ce1f397f"
