        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": false
      }
    ],
    "https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#ontoumlStereotype": [
      {
        "@value": "subkind"
      }
    ],
    "https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#sourceId": [
      {
        "@value": "RKM-C001"
      }
    ]
  },
  {
    "@id": "https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#RKM-C002",
