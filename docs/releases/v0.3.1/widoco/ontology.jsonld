      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A versioned information specification of analysis boundaries, circumstances, time horizon and objective references under which risk statements and results are interpreted."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "RiskContextSpecification"
      }
    ],
