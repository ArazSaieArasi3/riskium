  risk:isAbstractInSource "false"^^xsd:boolean .

risk:RKM-C071 a owl:Class ;
  risk:sourceId "RKM-C071" ;
  rdfs:label "Signal" ;
  rdfs:comment "An information item indicating a potentially relevant change or condition and potentially prompting review; it does not by itself establish a risk event." ;
  risk:ontoumlStereotype "subkind" ;
  risk:isAbstractInSource "false"^^xsd:boolean .

risk:RKM-C072 a owl:Class ;
  risk:sourceId "RKM-C072" ;
  rdfs:label "RiskCriteria" ;
  rdfs:comment "A versioned information specification of reference conditions used to judge the significance or acceptability of risk in an identified context." ;
  risk:ontoumlStereotype "subkind" ;
  risk:isAbstractInSource "false"^^xsd:boolean .

risk:RKM-C073 a owl:Class ;
  risk:sourceId "RKM-C073" ;
  rdfs:label "RiskAppetiteStatement" ;
  rdfs:comment "A managed, versioned statement recording the kinds and extent of risk an organization is prepared to pursue or retain, qualified by source framework, objectives, authority and context." ;
  risk:ontoumlStereotype "subkind" ;
  risk:isAbstractInSource "false"^^xsd:boolean .

risk:RKM-C074 a owl:Class ;
  risk:sourceId "RKM-C074" ;
  rdfs:label "RiskToleranceStatement" ;
  rdfs:comment "A managed, versioned statement recording an organization's stated risk tolerance under an explicitly identified source vocabulary or framework and context. Permissible deviation and readiness to bear remaining risk are retained as distinct source meanings, not silently merged." ;
  risk:ontoumlStereotype "subkind" ;
  risk:isAbstractInSource "false"^^xsd:boolean .

risk:RKM-X01 a owl:Class ;
  risk:sourceId "RKM-X01" ;
  rdfs:label "RiskCase" ;
  rdfs:comment "An instituted, identifiable subject of enterprise-risk analysis and tracking. It persists across its descriptions, reassessments, responsibilities and administrative record states under a governed identity policy. It is neither its register entry nor a scenario specification nor an actual occurrence." ;
  risk:ontoumlStereotype "kind" ;
  risk:isAbstractInSource "false"^^xsd:boolean .

risk:RKM-X02 a owl:Class ;
  risk:sourceId "RKM-X02" ;
  rdfs:label "ObjectiveReference" ;
  rdfs:comment "A managed information item identifying an objective in its source context, without asserting that the information item is the objective." ;
  risk:ontoumlStereotype "subkind" ;
  risk:isAbstractInSource "false"^^xsd:boolean .

risk:RKM-X03 a owl:Class ;
  risk:sourceId "RKM-X03" ;
  rdfs:label "UncertaintyStatement" ;
  rdfs:comment "A managed statement of what is uncertain about a risk case, including assumptions and evidential limitations; it does not imply a numerical probability." ;
  risk:ontoumlStereotype "subkind" ;
  risk:isAbstractInSource "false"^^xsd:boolean .

risk:RKM-X04 a owl:Class ;
  risk:sourceId "RKM-X04" ;
  rdfs:label "RiskEvaluationOutcome" ;
  rdfs:comment "A recorded judgment of risk significance or acceptability based on identified assessment information and criteria versions. It is distinct from a numeric score and from the evaluation activity." ;
  risk:ontoumlStereotype "subkind" ;
  risk:isAbstractInSource "false"^^xsd:boolean .

risk:RKM-X05 a owl:Class ;
  risk:sourceId "RKM-X05" ;
  rdfs:label "ControlReference" ;
  rdfs:comment "A managed identifier or description of a claimed control whose real-world bearer may remain unresolved." ;
  risk:ontoumlStereotype "subkind" ;
  risk:isAbstractInSource "false"^^xsd:boolean .

risk:RKM-X06 a owl:Class ;
  risk:sourceId "RKM-X06" ;
  rdfs:label "RiskSourceReference" ;
  rdfs:comment "A managed information artifact identifying or describing a claimed contributor to risk in a declared context. The referenced contributor may be unresolved, hypothetical or heterogeneous. The reference does not establish actual causation or an actual occurrence." ;
  risk:ontoumlStereotype "subkind" ;
  risk:isAbstractInSource "false"^^xsd:boolean .

