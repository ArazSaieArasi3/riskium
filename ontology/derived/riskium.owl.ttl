risk:RKM-C001 a owl:Class ;
  risk:sourceId "RKM-C001" ;
  rdfs:label "RiskPatternSpecification" ;
  rdfs:comment "A managed, reusable information specification of risk-relevant conditions and possible effects. Its identity is distinct from a particular risk case, a scenario execution and the uncertain effects themselves." ;
  risk:ontoumlStereotype "subkind" ;
  risk:isAbstractInSource "false"^^xsd:boolean .

risk:RKM-C002 a owl:Class ;
  risk:sourceId "RKM-C002" ;
  rdfs:label "RiskContextSpecification" ;
  rdfs:comment "A versioned information specification of analysis boundaries, circumstances, time horizon and objective references under which risk statements and results are interpreted." ;
  risk:ontoumlStereotype "subkind" ;
  risk:isAbstractInSource "false"^^xsd:boolean .

risk:RKM-C003 a owl:Class ;
  risk:sourceId "RKM-C003" ;
  rdfs:label "RiskScenarioSpecification" ;
  rdfs:comment "A managed information specification of a possible development of conditions, events and effects concerning one or more RiskCases. Several scenarios may concern one case; a scenario is not the case or an actual occurrence." ;
  risk:ontoumlStereotype "subkind" ;
  risk:isAbstractInSource "false"^^xsd:boolean .

risk:RKM-C004 a owl:Class ;
  risk:sourceId "RKM-C004" ;
  rdfs:label "RiskOccurrence" ;
  rdfs:comment "An actual occurrence or change relevant to a risk scenario; a scenario or report alone does not establish that it happened." ;
  risk:ontoumlStereotype "event" ;
  risk:isAbstractInSource "false"^^xsd:boolean .

risk:RKM-C005 a owl:Class ;
  risk:sourceId "RKM-C005" ;
  rdfs:label "RiskNatureAssertion" ;
  rdfs:comment "A source-qualified information assertion that possible or reported effects are favorable, unfavorable or mixed relative to identified objectives and context." ;
  risk:ontoumlStereotype "subkind" ;
  risk:isAbstractInSource "false"^^xsd:boolean .

risk:RKM-C006 a owl:Class ;
  risk:sourceId "RKM-C006" ;
  rdfs:label "NatureTerm" ;
  rdfs:comment "A controlled value used to qualify the nature of effects relative to objectives; it does not classify risk independently of context. This is a managed vocabulary resource with scheme-qualified identity, not a bare string." ;
  risk:ontoumlStereotype "subkind" ;
  risk:isAbstractInSource "false"^^xsd:boolean .

risk:RKM-C008 a owl:Class ;
  risk:sourceId "RKM-C008" ;
  rdfs:label "PredisposingCondition" ;
  rdfs:comment "A risk-relevant situation that increases susceptibility to specified occurrences or effects. Reference to it requires explicit source support and does not establish a causal mechanism." ;
  risk:ontoumlStereotype "situation" ;
  risk:isAbstractInSource "false"^^xsd:boolean .

risk:RKM-C009 a owl:Class ;
  risk:sourceId "RKM-C009" ;
  rdfs:label "Trigger" ;
  rdfs:comment "An actual occurrence interpreted as initiating a risk-relevant development in a specified context. A hypothetical trigger description is represented as scenario content, not as an actual Trigger individual." ;
  risk:ontoumlStereotype "event" ;
  risk:isAbstractInSource "false"^^xsd:boolean .

risk:RKM-C011 a owl:Class ;
  risk:sourceId "RKM-C011" ;
  rdfs:label "Vulnerability" ;
  rdfs:comment "An intrinsic susceptibility of a bearer to specified risk-relevant conditions or effects. The proposed mode interpretation requires a supported bearer; security-specific exploitation meanings remain source-qualified." ;
  risk:ontoumlStereotype "mode" ;
  risk:isAbstractInSource "false"^^xsd:boolean .

risk:RKM-C012 a owl:Class ;
  risk:sourceId "RKM-C012" ;
  rdfs:label "Exposure" ;
  rdfs:comment "A time-qualified situation relating an affected bearer to a risk source or relevant condition. An exposure score or its description is information about that situation." ;
  risk:ontoumlStereotype "situation" ;
  risk:isAbstractInSource "false"^^xsd:boolean .

risk:RKM-C013 a owl:Class ;
  risk:sourceId "RKM-C013" ;
  rdfs:label "RiskState" ;
  rdfs:comment "A temporally qualified state of a risk-relevant situation, distinct from the workflow status of its record." ;
  risk:ontoumlStereotype "situation" ;
  risk:isAbstractInSource "false"^^xsd:boolean .

risk:RKM-C014 a owl:Class ;
  risk:sourceId "RKM-C014" ;
  rdfs:label "InformationArtifact" ;
  rdfs:comment "A managed documentary object with an instituted identity that persists across its descriptions and issued versions. Artifact identity is distinct from a file path, a storage row and semantic content." ;
  risk:ontoumlStereotype "kind" ;
  risk:isAbstractInSource "false"^^xsd:boolean .

risk:RKM-C015 a owl:Class ;
  risk:sourceId "RKM-C015" ;
  rdfs:label "ArtifactVersion" ;
  rdfs:comment "An identifiable issued documentary version of a managed information artifact. Its issued semantic content and effective dependency versions are immutable; revisions receive distinct version identities." ;
  risk:ontoumlStereotype "kind" ;
  risk:isAbstractInSource "false"^^xsd:boolean .

risk:RKM-C016 a owl:Class ;
  risk:sourceId "RKM-C016" ;
  rdfs:label "InformationContent" ;
