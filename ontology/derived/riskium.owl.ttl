risk:RKM-C022 a owl:Class ;
  risk:sourceId "RKM-C022" ;
  rdfs:label "RiskRegisterEntry" ;
  rdfs:comment "A managed register record about exactly one RiskCase in this profile. Distinct entries, source systems or registers can record the same case. A software record is an implementation record, not an additional risk subject." ;
