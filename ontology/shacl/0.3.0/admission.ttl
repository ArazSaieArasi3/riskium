ad:LanguageTitle sh:datatype rdf:langString .

ad:RequestedTask a sh:PropertyShape ;
    sh:in ( ap:CatalogInspection ) ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path ap:requestedTask .

ad:RequiredTask a sh:PropertyShape ;
    sh:minCount 1 ;
    sh:path ap:requestedTask .

ad:Source a sh:PropertyShape ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path dct:source .

ad:StringTitle sh:datatype xsd:string .

ad:Subject a sh:PropertyShape ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path dct:subject .

ad:Title a sh:PropertyShape ;
    sh:minCount 1 ;
    sh:or ( ad:StringTitle ad:LanguageTitle ) ;
    sh:path dct:title ;
    sh:pattern "\\S" .

