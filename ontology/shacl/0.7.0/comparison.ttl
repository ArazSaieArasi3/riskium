    sh:path sp:leftAssessment .

cmp:LeftBasis a sh:PropertyShape ;
    sh:class risk:RKM-C033 ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path ( sp:leftAssessment risk:R-12 ) .

cmp:LeftBasisBindingMismatchQuery a sh:SPARQLConstraint ;
    sh:message "LeftBasisBindingMismatch: exact declarations and explicit identity evidence govern this task." ;
    sh:select """PREFIX risk: <https://github.com/ArazSaieArasi3/riskium/ontologies/riskium/0.3.1#>
PREFIX sp: <https://github.com/ArazSaieArasi3/riskium/profiles/comparison/0.7.0#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
SELECT DISTINCT $this WHERE {
$this sp:leftAssessment ?assessment ; sp:leftResult ?result .
?assessment sp:basisVersion/risk:RX-006 ?a ; risk:R-12 ?b .
FILTER (?a != ?b)
FILTER EXISTS { ?a owl:differentFrom ?b }
}""" .

