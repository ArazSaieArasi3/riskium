cmp:Comparison a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property cmp:LeftAssessment,
        cmp:LeftBasis,
        cmp:LeftBasisVersion,
        cmp:LeftBasisVersionTarget,
        cmp:LeftContext,
        cmp:LeftContextVersion,
        cmp:LeftContextVersionTarget,
        cmp:LeftMethod,
        cmp:LeftMethodVersion,
        cmp:LeftMethodVersionTarget,
        cmp:LeftSource,
        cmp:LeftTemporal,
        cmp:RightAssessment,
        cmp:RightBasis,
        cmp:RightBasisVersion,
        cmp:RightBasisVersionTarget,
        cmp:RightContext,
        cmp:RightContextVersion,
        cmp:RightContextVersionTarget,
        cmp:RightMethod,
        cmp:RightMethodVersion,
        cmp:RightMethodVersionTarget,
        cmp:RightSource,
        cmp:RightTemporal .

